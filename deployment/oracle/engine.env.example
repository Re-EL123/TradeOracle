# Engine environment — copy to /opt/tradeoracle/deployment/oracle/engine.env
# chmod 600, owner tradeoracle. NEVER commit real values.
TRADING_MODE=RESEARCH
MARKET_DATA_PROVIDER=synthetic
SYMBOLS=EURUSD,GBPUSD,USDJPY
TIMEFRAMES=M15,H1,H4
ENGINE_CYCLE_INTERVAL_SECONDS=30

# Risk defaults (engine enforces; API settings sync via MongoDB)
RISK_PER_TRADE_PCT=0.25
DAILY_LOSS_LIMIT_PCT=1.0
MAX_OPEN_POSITIONS=2

MONGODB_URI=
SESSION_SECRET=
ENGINE_WORKER_TOKEN=
LOG_LEVEL=INFO
